<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F5A98F"
                android:startColor="#5F62B7" />
        </shape>
    </item>

    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="#203B92" />
            <size android:height="300dp" />
        </shape>
    </item>

    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="#304DA4" />
            <size android:height="220dp" />
        </shape>
    </item>

    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="#1C347F" />
            <size android:height="170dp" />
        </shape>
    </item>
</layer-list>
