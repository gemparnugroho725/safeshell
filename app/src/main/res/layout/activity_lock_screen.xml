<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launcher_wallpaper"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Lock icon"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="#F7FAFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Enter Passcode"
            android:textColor="#F7FAFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/passcodeIndicator"
            android:layout_width="188dp"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_passcode_box"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="○ ○ ○ ○"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key1"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key2"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key3"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key4"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key5"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="5"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key6"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="6"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key7"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="7"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key8"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="8"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key9"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="9"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key0"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDelete"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_margin="8dp"
                    android:text="DEL"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:backgroundTint="#33FFFFFF"
                    app:cornerRadius="37dp"
                    app:rippleColor="#44FFFFFF"
                    app:strokeColor="#66FFFFFF"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
